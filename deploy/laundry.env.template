# Laundry App — Production Environment Variables Template
#
# Usage:
#   1. Copy this file:  cp laundry.env.template /opt/laundry/laundry.env
#   2. Fill in every value marked <REQUIRED>
#   3. Secure the file:  chmod 600 /opt/laundry/laundry.env
#                        chown laundry:laundry /opt/laundry/laundry.env
#   4. Start the service: sudo systemctl start laundry
#
# NEVER commit this file with real secrets to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Spring Profile ─────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod

# ── Database ───────────────────────────────────────────────────────────────
# Format: jdbc:mysql://<host>:<port>/<database>?useSSL=true&serverTimezone=UTC
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/laundry_prod?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# Use the dedicated app user created by mysql-setup.sql — NEVER root
SPRING_DATASOURCE_USERNAME=laundry_app                          # <REQUIRED>
SPRING_DATASOURCE_PASSWORD=<REQUIRED: strong random password>

# ── JWT ────────────────────────────────────────────────────────────────────
# Must be at least 32 random characters for HMAC-SHA256.
# Generate with: openssl rand -hex 32
JWT_SECRET=<REQUIRED: openssl rand -hex 32>

# Token lifetimes in seconds (defaults: 1h access, 7d refresh)
JWT_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=604800

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
CORS_ALLOWED_ORIGINS=https://YOUR_DOMAIN                        # <REQUIRED>

# ── Frontend URL (used for WhatsApp receipt links etc.) ───────────────────
WEBSITE_URL=https://YOUR_DOMAIN

# ── File Uploads ───────────────────────────────────────────────────────────
# Absolute path on the server. Directory must exist and be writable by the laundry user.
UPLOAD_DIR=/app/uploads

# ── Server ─────────────────────────────────────────────────────────────────
PORT=8080

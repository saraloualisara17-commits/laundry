# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit secrets.

# Spring Boot backend URL (Railway production or local dev)
EXPO_PUBLIC_API_URL=https://your-app.up.railway.app

# OpenRouteService API key for driver map directions
# Obtain a free key at https://openrouteservice.org/
EXPO_PUBLIC_ORS_API_KEY=your_ors_api_key_here

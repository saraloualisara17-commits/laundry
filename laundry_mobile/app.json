{
  "expo": {
    "jsEngine": "hermes",
    "name": "Astra Pro",
    "slug": "laundry_mobile",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "laundrymobile",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Used to take photos of orders for delivery and pickup proof.",
        "NSPhotoLibraryUsageDescription": "Used to attach photos from your gallery to orders.",
        "NSLocationWhenInUseUsageDescription": "Used to show your position on the delivery map.",
        "NSMicrophoneUsageDescription": "Required by the camera system on iOS."
      }
    },
    "android": {
      "adaptiveIcon": {
       "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.smlouali.laundrymobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.VIBRATE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Used to take photos of orders for delivery and pickup proof."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Used to attach photos from your gallery to orders.",
          "cameraPermission": "Used to take photos of orders."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Used to show your position on the delivery map."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0D7377",
          "sounds": []
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-localization",
      "expo-updates",
      "expo-secure-store"
    ],
    "updates": {
      "url": "https://u.expo.dev/f81f325d-b523-433e-849e-a8fe1aa005d5"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f81f325d-b523-433e-849e-a8fe1aa005d5"
      }
    }
  }
}
